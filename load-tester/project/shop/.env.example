# Подключения внутри сети Compose; shop/shop — открытые учебные реквизиты.
DATABASE_URL=postgresql://shop:shop@postgres:5432/shop
REDIS_URL=redis://redis:6379/0
PAYMENT_URL=http://payment:8001
# Число воркеров; каждый имеет собственный пул БД.
WEB_CONCURRENCY=1
# Минимум, максимум соединений НА ВОРКЕР и ожидание свободного соединения (секунды).
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_TIMEOUT=5
# Стоимость bcrypt: высокая стоимость нагружает CPU при входе.
BCRYPT_ROUNDS=12
# Кеш карточек выключен; TTL в секундах.
CACHE_ENABLED=0
CACHE_TTL=60
# 1 — позиции последних заказов читаются отдельным запросом на каждый заказ.
BUG_N_PLUS_ONE=1
# 1 — сохранять 10 КБ на каждый запрос навсегда, для soak-теста.
LEAK_ENABLED=0
# Таймаут одной попытки оплаты (секунды), число ПОВТОРОВ после первой попытки.
PAYMENT_TIMEOUT=10
PAYMENT_RETRIES=3
# Время жизни сессии в секундах и уровень логирования.
SESSION_TTL=3600
LOG_LEVEL=INFO
# Задержка заглушки оплаты (миллисекунды) и вероятность отказа от 0 до 1.
PAYMENT_DELAY_MS=50
PAYMENT_FAIL_RATE=0.0
# Каталог метрик внутри контейнера; очищается при запуске shop.
PROMETHEUS_MULTIPROC_DIR=/tmp/shop-metrics
# Трейсы OpenTelemetry: 1 - включены. Экспорт идёт в Alloy (профиль monitoring);
# без него shop и payment работают, спаны просто отбрасываются.
TRACING_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Доля трейсов: parentbased_always_on (все) или parentbased_traceidratio с долей в ARG.
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
